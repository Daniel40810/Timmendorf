// probe.comp — Compute-Test beim Start (aus Lighthouse): Präfixsumme in geteiltem Speicher je Arbeitsgruppe (Hillis-Steele).
// Prüft Compute-Shader, SSBO, shared und barrier(), also alles, was die FFT des Sees (com.dan.ocean) und später wave brauchen.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Daten { uint werte[]; };
shared uint teil[64];

void main() {
    uint i = gl_LocalInvocationID.x;
    uint g = gl_WorkGroupID.x;
    teil[i] = g * 64u + i + 1u;
    barrier();
    for (uint s = 1u; s < 64u; s <<= 1u) {
        uint v = i >= s ? teil[i - s] : 0u;
        barrier();
        teil[i] += v;
        barrier();
    }
    werte[g * 64u + i] = teil[i];
}
